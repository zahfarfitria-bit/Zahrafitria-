    <script>
        // -------------------------------------------------------------
        // 1. Audio Synthesizer Engine (Web Audio API for sound effects)
        // -------------------------------------------------------------
        let audioEnabled = true;
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new AudioContext();
            }
        }

        function toggleAudioSynth() {
            audioEnabled = !audioEnabled;
            const soundIcon = document.getElementById('sound-icon');
            if (audioEnabled) {
                soundIcon.className = "fa-solid fa-volume-high";
            } else {
                soundIcon.className = "fa-solid fa-volume-xmark";
            }
        }

        function playSoundTone(freq, type = 'sine', duration = 0.2) {
            if (!audioEnabled) return;
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.log("Audio play error", e);
            }
        }

        // Piano note player
        function playNote(freq, noteName) {
            playSoundTone(freq, 'triangle', 0.4);
            const display = document.getElementById('note-played-display');
            if (display) {
                display.innerText = `🎵 Menyanyikan Nada: ${noteName} (${Math.round(freq)} Hz)!`;
            }
