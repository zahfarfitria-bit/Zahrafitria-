        let currentNum1 = 0;
        let currentNum2 = 0;
        let currentOperator = '+';
        let currentCorrectAnswer = 0;
        let difficulty = 'easy';

        document.getElementById('game-highscore').innerText = gameHighScore;

        function setDifficulty(diff) {
            difficulty = diff;
            generateMathQuestion();
            playSoundTone(523.25, 'sine', 0.1);
        }

        function generateMathQuestion() {
            const ops = difficulty === 'easy' ? ['+'] : difficulty === 'medium' ? ['+', 'x'] : ['+', '-', 'x'];
            currentOperator = ops[Math.floor(Math.random() * ops.length)];

            if (currentOperator === '+') {
                currentNum1 = Math.floor(Math.random() * 20) + 1;
                currentNum2 = Math.floor(Math.random() * 20) + 1;
                currentCorrectAnswer = currentNum1 + currentNum2;
            } else if (currentOperator === '-') {
                currentNum1 = Math.floor(Math.random() * 20) + 10;
                currentNum2 = Math.floor(Math.random() * currentNum1) + 1;
                currentCorrectAnswer = currentNum1 - currentNum2;
            } else if (currentOperator === 'x') {
                currentNum1 = Math.floor(Math.random() * 10) + 1;
                currentNum2 = Math.floor(Math.random() * 10) + 1;
                currentCorrectAnswer = currentNum1 * currentNum2;
            }

            const opSymbol = currentOperator === 'x' ? '×' : currentOperator;
            document.getElementById('math-question').innerText = `${currentNum1} ${opSymbol} ${currentNum2} = ?`;
            document.getElementById('math-answer').value = '';
            document.getElementById('math-answer').focus();
        }

        function checkMathAnswer(e) {
