        }

        // -------------------------------------------------------------
        // 7. PWA Dynamic Manifest & Service Worker Registration
        // -------------------------------------------------------------
        const manifestData = {
            "name": "Zhara Fitria - Profil & Fun Game Zone",
            "short_name": "ZharaFitria",
            "start_url": ".",
            "display": "standalone",
